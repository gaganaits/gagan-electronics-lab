# Gagan Electronics Lab - Environment Variables Template
# Copy this file to .env.local and populate with your actual credentials.
# NEVER commit .env or .env.local with real secrets to version control.

# Supabase (Public client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase (Server-only privileged access - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Storage Bucket Name
NEXT_PUBLIC_STORAGE_BUCKET=quote-files

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin fallback credentials (for local dev / demo before Supabase Auth is linked)
ADMIN_SECRET_KEY=dev-admin-secret-change-in-production
ADMIN_EMAIL=admin@gaganelectronicslab.com
ADMIN_PASSWORD=change-me-in-production-secure-password
